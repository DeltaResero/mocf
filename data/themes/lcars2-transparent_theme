###############################################################################
#
# Lcars 2 Transparent Theme (Star Trek Inspired)
# by Tomasz Golinski <tomaszg@math.uwb.edu.pl>
#
# FORMAT: element = foreground background attributes
# COLORS: black, red, green, yellow, blue, magenta, cyan, white, default
# ATTRIBUTES: bold, underline, reverse, blink, dim (combine with commas)
#
###############################################################################


# =============================================================================
# BASE INTERFACE
# =============================================================================

# --- Core UI Elements (window, frame, background) ---
background           = default default
frame                = yellow  black   reverse
window_title         = magenta black   reverse


# =============================================================================
# FILE BROWSER & PLAYLIST
# =============================================================================

# --- Directories (folder display) ---
directory            = blue    default
selected_directory   = black   red

# --- Playlists (playlist display) ---
playlist             = magenta default
selected_playlist    = black   red

# --- Files (file browser) ---
file                 = green   default
selected_file        = black   red

# --- Currently Playing Track (marked items) ---
marked_file          = red     default
marked_selected_file = white   red


# =============================================================================
# INFORMATION DISPLAY
# =============================================================================

# --- File Info (duration, format - right side) ---
info                 = blue    default
marked_info          = blue    default
marked_selected_info = white   red
selected_info        = black   red

# --- Status Bar (bottom status line) ---
state                = red     default
status               = red     default
title                = yellow  default


# =============================================================================
# TIME DISPLAY
# =============================================================================

# --- Time Elements (elapsed, remaining, total) ---
current_time         = white   default
plist_time           = blue    default
time_left            = white   default
time_total_frames    = white   default
total_time           = white   default


# =============================================================================
# AUDIO PARAMETERS
# =============================================================================

# --- Audio Information (rate, bitrate, channels) ---
sound_parameters     = blue    default


# =============================================================================
# MENU & OPTIONS
# =============================================================================

# --- Menu Elements (options, legend) ---
legend               = blue    default
disabled             = blue    default
enabled              = yellow  default reverse


# =============================================================================
# PROGRESS BARS
# =============================================================================

# --- Volume Mixer Bar (bottom right) ---
empty_mixer_bar      = black   default
filled_mixer_bar     = white   red

# --- Time Progress Bar (bottom left) ---
empty_time_bar       = black   default
filled_time_bar      = black   red


# =============================================================================
# MESSAGES & INPUT
# =============================================================================

# --- Text Entry (input prompts) ---
entry                = cyan    default
entry_title          = black   cyan

# --- Messages (errors, notifications) ---
error                = yellow  default
message              = red     default


# EOF
